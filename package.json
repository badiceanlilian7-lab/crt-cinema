{
  "name": "crt-cinema",
  "version": "1.0.0",
  "description": "CRT Cinema Donduseni - Management System with QR Codes",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
